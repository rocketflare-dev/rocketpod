# Dependencies
node_modules/
.pnpm-store/

# Build outputs
**/dist/

# Secrets — never commit. `.env.example` and `.env.test` (dummy values) ARE committed.
**/.env
**/.env.*
!**/.env.example
!**/.env.test
*.local
.secrets.*.json
.drizzle-cube.json  # the analytics plugin's local tooling config (D31) — never committed

# Logs / coverage
logs/
*.log
coverage/
*.lcov

# Editor / OS
.DS_Store
.idea/
.vscode/

# Drizzle studio
.drizzle/

# Agent worktrees (transient, each is its own git repo)
.claude/worktrees/
.claude/settings.local.json
# Kit update check cache (scripts/kit-update-check.mjs — the newest release, at most a day old)
.claude/kit-update-check.json


# Plugins installed into THIS checkout only (D31): the kit, or `pnpm plugin add --local`.
# An app records its plugins as surfaces in the committed `.rocketflare.json` instead.
.rocketflare.local.json

# Kit upgrade cache — the bare mirror of the kit and the working artifacts of
# `pnpm kit:upgrade` (scripts/upgrade.mjs), plus `plugins/` holding the same two for every plugin
# `pnpm plugin add|upgrade` has fetched (D31). Safe to delete at any time.
.upgrade/
