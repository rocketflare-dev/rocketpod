# Copy to `.env` (git-ignored). `pnpm dev` loads it into the Node server's environment; the
# db:*/seed scripts load it with dotenv-cli. Deployed, the same keys are the server's environment. Never put alternate credentials in comments.

# --- Required ---------------------------------------------------------------------------
# Without these the server would run as APP_ENV=production with no APP_URL, and cookie-authed
# POSTs from the Vite origin (:3000) would fail CSRF.
APP_ENV=development
# APP_URL follows the UI port: change it together with DEV_UI_PORT below.
APP_URL=http://localhost:3000
# Dev ports (scripts/lib/dev-ports.mjs), for a machine where :3000/:3001 are taken (a sandbox
# holds :3000). The shell wins over this file; unset means 3000 (Vite) / 3001 (the Node server).
# `pnpm dev`, Vite, the bootstrap and the seed read them; `pnpm dev:api` alone reads only the shell.
# DEV_UI_PORT=3000
# DEV_API_PORT=3001
# Extra hostnames Vite answers for, comma-separated (a sandbox preview URL's host).
# DEV_ALLOWED_HOSTS=
# Database driver (D35): `postgres` — postgres.js over TCP, the only driver Rocketpod has (`neon` was
# removed and is refused with the fix). The bootstrap writes this line.
DATABASE_DRIVER=postgres
# Owner connection string for local Postgres (docker-compose.dev.yml). Deployed, the Node server
# reads DATABASE_URL; this is the local one, and what scripts/migrate.ts, db-roles.ts, seed.ts and drizzle-kit use.
DATABASE_URL=postgresql://rocketpod:rocketpod_pass@localhost:5432/rocketpod_dev
# TLS to Postgres for EVERY connection (pool, LISTEN, pg-boss, OpenWorkflow, migrate): off | require
# (TLS, certificate not verified) | verify-full (verified against the system CAs + NODE_EXTRA_CA_CERTS).
# Blank = the URL's own `sslmode` decides; set, a URL carrying `sslmode` is refused. Local Docker: blank.
DATABASE_SSL=
# AES-GCM key for OAuth tokens stored at rest. Generate: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=
# Feature flags, layer 1 (D30): comma-separated keys this machine ships AT ALL. Only consulted for
# a flag whose registry entry sets `environmentGated`; an ordinary rollout flag ignores it.
# Blank = none, so a flag you ship dark is dark on every laptop until you list it here.
FEATURES_ENABLED=
# Agent human-in-the-loop (#17): how long a run parked on a person waits before it expires. Passed
# verbatim to `step.waitForEvent`, so it must be a duration string ("168 hours", "7 days").
AGENT_INTERRUPT_TIMEOUT=168 hours
# Agent volume: runs one organisation may have queued, running or parked at once (429 above).
AGENT_MAX_ACTIVE_RUNS_PER_TENANT=50
# Agent budgets — blank = no cap. Per run: tokens (input, output and prompt-cache reads and
# writes) and USD; an agent's `meta.budget` overrides either. While a USD cap applies, a call the
# deployment pays for on a model with no known price is refused. Per organisation per UTC day: USD across every run.
AGENT_RUN_MAX_TOKENS=
AGENT_RUN_MAX_COST_USD=
AGENT_TENANT_DAILY_COST_USD=
# Days a settled agent run keeps its tool-loop journal (model turns and tool results, what a strict
# replay answers from), pruned nightly. Blank = 30.
AGENT_TRANSCRIPT_RETENTION_DAYS=
# The deployed build an agent run records per attempt (`worker_version_id`). Helm sets the image
# tag; blank locally = none.
APP_VERSION_ID=
# Knowledge — blank = off / the default. What one organisation's knowledge work (embeddings,
# reranking, fact extraction) may spend per UTC day in USD; only fact extraction pauses at it.
# Reranking (with a tenant reranker): fused candidates sent to it (5–100, default 20), and the
# score (0–1) under which a hit is dropped.
KNOWLEDGE_TENANT_DAILY_COST_USD=
RERANK_CANDIDATES=
RERANK_MIN_SCORE=
# Organisations one person may own (403 above; global admins exempt), and invitation emails per
# UTC day per sender and per organisation (429 above). Blank = the defaults: 10, 500, 1000.
MAX_OWNED_TENANTS_PER_USER=
INVITATION_EMAILS_PER_USER_PER_DAY=
INVITATION_EMAILS_PER_TENANT_PER_DAY=

# --- Optional (feature-gated when absent) -----------------------------------------------
# Email. EMAIL_PROVIDER: log | resend | ses. Blank = resend when RESEND_API_KEY is set, else log
# (magic-link URLs in the `pnpm dev` output). `ses` sends through Amazon SES v2 on the AWS SDK's
# default credentials (an ECS task role, a profile) — no key here — and needs EMAIL_FROM set to an
# identity SES has verified. SES_REGION blank = AWS_REGION; SES_CONFIGURATION_SET is optional.
EMAIL_PROVIDER=
# EMAIL_FROM=Your App <noreply@your-domain.example>
RESEND_API_KEY=
SES_REGION=
SES_CONFIGURATION_SET=
# Comma-separated emails promoted to global admin on their first *verified* login.
BOOTSTRAP_ADMIN_EMAILS=
# OAuth providers: leave blank to hide the button. Redirect URI is derived from APP_URL:
#   {APP_URL}/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Any OpenID Connect issuer (Keycloak, Okta, Entra single-tenant, Auth0…) — SETUP.md "Sign in with
# any OIDC issuer". Blank OIDC_ISSUER = no SSO button. Redirect URI: {APP_URL}/auth/oidc/callback.
# OIDC_ISSUER must equal the issuer's `issuer` value exactly (trailing slash included if it has one).
# Deployed, OIDC_ISSUER/CLIENT_ID/LABEL/SCOPES and AUTH_OIDC_ONLY are plain environment variables;
# OIDC_CLIENT_SECRET is a secret (omit it for a public client — PKCE only).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=
OIDC_SCOPES=
# true = the login page shows only the SSO button (still a click) and hides the other methods (needs the two above).
AUTH_OIDC_ONLY=
# true = trust the issuer's email when it omits `email_verified` (single-tenant Entra does). Default
# false: such a sign-in is refused. An explicit `email_verified: false` is refused either way.
OIDC_TRUST_EMAIL=
# IdP-managed tenancy (SETUP.md 2.3c). true = each OIDC sign-in reconciles tenants, memberships and
# global admin from the id_token, admission comes from the claims (not SIGNUP_MODE), and an OIDC
# session ends OIDC_SESSION_MAX_AGE_DAYS (default 7, at most 30) after sign-in. Needs OIDC_ISSUER + OIDC_CLIENT_ID.
OIDC_MANAGED_TENANCY=
# The claim holding [{ id, name, slug?, role }] (default orgs), and issuerRole:admin|member pairs
# (default admin:admin,member:member).
OIDC_ORGS_CLAIM=
OIDC_ROLE_MAP=
# Optional boolean claims: one admits a person with no orgs, one makes them a global admin.
OIDC_ADMIT_CLAIM=
OIDC_GLOBAL_ADMIN_CLAIM=
OIDC_SESSION_MAX_AGE_DAYS=
# The issuer's identity-event signing secret (whsec_…): enables POST /api/identity/events.
IDENTITY_WEBHOOK_SECRET=
# MCP server at {APP_URL}/mcp (docs/CONCEPTS.md §19): on only where FEATURES_ENABLED lists `mcp`,
# then per organisation at Settings → MCP. The app is its own OAuth authorization server.
# Connection lifetime (days idle / absolute), call-log retention (days), calls per minute.
MCP_GRANT_IDLE_DAYS=
MCP_GRANT_MAX_DAYS=
MCP_CALL_RETENTION_DAYS=
MCP_CALLS_PER_GRANT_PER_MINUTE=
MCP_CALLS_PER_USER_PER_MINUTE=
MCP_CALLS_PER_TENANT_PER_MINUTE=
# Optional second issuer: an OUTSIDE OAuth server (its `issuer`, verbatim) whose JWT access tokens
# /mcp also accepts — bound to {APP_URL}/mcp, the person found by `email` (and the orgs claim under
# OIDC_MANAGED_TENANCY), the organisation from /mcp/t/<slug> or the `mcp-tenant` header.
MCP_AUTHORIZATION_SERVER=
# AI layer (Phase 3): platform default key; tenants may override in Settings → AI. Chat resolves
# ANTHROPIC_API_KEY, then AI_API_KEY (OpenAI-compatible: OpenRouter, vLLM, Ollama… at AI_BASE_URL with
# AI_MODEL; OpenAI itself when AI_BASE_URL is blank). Embeddings use EMBEDDINGS_API_KEY (OpenAI, or an
# OpenAI-compatible EMBEDDINGS_BASE_URL + EMBEDDINGS_MODEL that answers 1024 dimensions). On the Node
# server nothing else exists: no key → chat/agents answer 503.
ANTHROPIC_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
# Object storage for uploads on the Node server (M6). `pnpm dev:db:up` starts the S3 gateway in
# docker-compose.dev.yml and rewrites these to match; any S3-compatible store works (AWS S3, R2's S3
# endpoint, MinIO…). Blank STORAGE_DRIVER = no storage (uploads answer 503). The two keys are a
# pair or neither: neither = the AWS SDK's default credential chain (an ECS task role on AWS).
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:7070
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rocketpod-dev
STORAGE_ACCESS_KEY_ID=rocketpod-dev
STORAGE_SECRET_ACCESS_KEY=rocketpod-dev-secret
STORAGE_FORCE_PATH_STYLE=true
# The storage tenant fence (docs/TENANT-ISOLATION.md): off (default) | shadow | on. shadow/on sign
# each tenant's objects with an STS session of FILES_ROLE_ARN tagged tenant=<id>, whose policy
# admits tenants/<id>/ only; shadow logs storage.fence_denied and still serves. Needs AWS STS:
# leave it off with the local gateway.
STORAGE_TENANT_FENCE=off
FILES_ROLE_ARN=
# Decisions (D37): TypeSafe's Jev answers `ctx.decide` with calibrated probabilities. Optional —
# without it (and without a tenant Decisions row in Settings → AI) decisions fall back to the chat
# model's self-reported probabilities, recorded as `llm_self_report` (uncalibrated).
TYPESAFE_API_KEY=
# Evals only (D33, docs/EVALS.md): `pnpm eval --provider fireworks|gemini` (and `--judge-provider`)
# read these; the server never does, which is why they are comments here.
# FIREWORKS_API_KEY=
# GEMINI_API_KEY=
# AI tracing (D32). Spans ALWAYS land in the local `ai_spans` table (`pnpm cli traces list`);
# these only add an OTLP backend. Langfuse: both keys are enough (preset auto-selected, Langfuse
# Cloud unless OTEL_EXPORTER_OTLP_ENDPOINT points elsewhere). Phoenix locally:
#   docker run -p 6006:6006 arizephoenix/phoenix  →  OBSERVABILITY_PRESET=phoenix,
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006 (protobuf by default — Phoenix takes nothing else).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OBSERVABILITY_PRESET=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Extra request headers, k=v,k=v (URL-encode values) — e.g. authorization=Bearer%20<key>
OTEL_EXPORTER_OTLP_HEADERS=
# Link-out for `traces show`: {traceId} is substituted.
OBSERVABILITY_TRACE_URL=
# Off by default: `true` records prompts, completions and tool I/O in the export AND `ai_spans`.
OBSERVABILITY_CAPTURE_CONTENT=false

# --- Tenant isolation (docs/TENANT-ISOLATION.md, docs/RLS.md) --------------------------
# A separate NON-owner login for the server (web, worker). Set, every runtime connection uses it,
# working as the rocketpod_system role, and db:migrate (as DATABASE_URL, the owner) creates the
# login, sets its password and grants it. Any user name but the owner's, rocketpod_app or
# rocketpod_system. Blank = the server uses DATABASE_URL, as before.
APP_DATABASE_URL=
