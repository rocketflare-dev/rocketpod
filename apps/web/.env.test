# Test environment (dummy values only — safe to commit). Loaded by `pnpm test` via dotenv-cli.
NODE_ENV=test
APP_ENV=development
APP_URL=http://localhost:3001
APP_NAME=Rocketpod Test
LOG_LEVEL=silent
TENANCY_MODE=multi
SIGNUP_MODE=invite_only

# Test database (docker-compose.test.yml, host port 5533), over postgres.js (D35 — the one driver).
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://test:test@localhost:5533/rocketpod_test
# App role used by RLS policies. Created NOLOGIN by db-roles.ts when the credential is unset;
# tests run predicates-only (TENANT_SCOPE_MODE=off) — see docs/RLS.md for the enforce spike.
APP_DATABASE_URL=postgresql://rocketpod_app:test_app@localhost:5533/rocketpod_test
TENANT_SCOPE_MODE=off

OAUTH_ENCRYPTION_KEY=test_encryption_key_0000000000000000000000000000000000000000000000

GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
MICROSOFT_CLIENT_ID=test_microsoft_client_id
MICROSOFT_CLIENT_SECRET=test_microsoft_client_secret

# Object storage (M6): the S3 gateway in docker-compose.test.yml (host port 7433), bucket created
# by its entrypoint. Dummy credentials, matching the compose file.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:7433
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rocketpod-test
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test-secret-key
STORAGE_FORCE_PATH_STYLE=true
