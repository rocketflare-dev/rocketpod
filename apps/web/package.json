{
  "name": "@rocketpod/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rocketpod kit web app: Hono API + React UI on Node, Postgres + Drizzle",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs --start",
    "dev:stop": "node scripts/dev-server.mjs --stop",
    "dev:status": "node scripts/dev-server.mjs --status",
    "dev:api": "mkdir -p dist/ui && PORT=${DEV_API_PORT:-3001} node scripts/dev-db.mjs env -- dotenv -e .env -- tsx watch src/node/server.ts all",
    "dev:ui": "vite",
    "dev:db:up": "node scripts/dev-db.mjs up",
    "dev:db:down": "node scripts/dev-db.mjs down",
    "dev:db:status": "node scripts/dev-db.mjs status",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "build": "pnpm build:ui && pnpm build:server",
    "build:ui": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "clean": "rm -rf dist coverage",
    "test": "pnpm test:shared && pnpm test:isolated",
    "test:shared": "NODE_ENV=test dotenv -e .env.test -- vitest run --project api --no-isolate",
    "test:isolated": "NODE_ENV=test dotenv -e .env.test -- vitest run --project api-isolated --project driver --project ui --project config --project kit-only",
    "test:api": "pnpm test:shared && NODE_ENV=test dotenv -e .env.test -- vitest run --project api-isolated",
    "test:driver": "NODE_ENV=test dotenv -e .env.test -- vitest run --project driver",
    "test:ui": "NODE_ENV=test dotenv -e .env.test -- vitest run --project ui",
    "test:config": "NODE_ENV=test dotenv -e .env.test -- vitest run --project config",
    "test:kit-only": "NODE_ENV=test dotenv -e .env.test -- vitest run --project kit-only",
    "test:coverage": "NODE_ENV=test dotenv -e .env.test -- vitest run --coverage",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- tsx scripts/db-roles.ts --phase=role && dotenv -e .env -- tsx scripts/migrate.ts && dotenv -e .env -- tsx scripts/db-roles.ts --phase=grants",
    "db:migrate:ci": "tsx scripts/db-roles.ts --phase=role && tsx scripts/migrate.ts && tsx scripts/db-roles.ts --phase=grants",
    "db:roles": "dotenv -e .env -- tsx scripts/db-roles.ts",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "db:check": "dotenv -e .env -- tsx scripts/test-db-connection.ts",
    "seed": "dotenv -e .env -- tsx scripts/seed.ts"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@ag-ui/proto": "1.0.2",
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/lib-storage": "3.1150.0",
    "@casl/ability": "^6.8.1",
    "@casl/react": "^5.0.1",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.7.6",
    "@rocketpod/shared": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "arctic": "^3.7.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "hono-pino": "^0.10.3",
    "jose": "^6.2.12",
    "mammoth": "1.13.0",
    "openworkflow": "0.10.1",
    "pg-boss": "12.37.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1",
    "unpdf": "1.8.1",
    "ws": "8.21.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.2",
    "daisyui": "^5.7.23",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
