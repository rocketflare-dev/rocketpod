# Copy to `.env` at the repository root for `docker compose` (docs/DEPLOY.md). Every value has
# a default in docker-compose.yml; set the ones you need. Never commit the copy.

# The origin people use. `__Host-` session cookies need https anywhere but localhost.
APP_URL=http://localhost:3001
APP_ENV=production
SIGNUP_MODE=invite_only
# APP_ENV=production never logs a sign-in link: set RESEND_API_KEY / EMAIL_PROVIDER (or OIDC) for
# the first admin to sign in, or APP_ENV=staging for a local try-out only (the link is then logged).
# The first admin: signs in by magic link.
BOOTSTRAP_ADMIN_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=Rocketpod <noreply@example.com>
# log | resend | ses (blank = resend with RESEND_API_KEY, else log). ses: Amazon SES v2 on the
# host's AWS credentials, EMAIL_FROM an identity SES has verified; SES_REGION blank = AWS_REGION.
EMAIL_PROVIDER=
SES_REGION=
SES_CONFIGURATION_SET=
# 32+ characters; needed for OAuth sign-in (openssl rand -base64 32).
OAUTH_ENCRYPTION_KEY=

# Change before exposing anything.
POSTGRES_PASSWORD=rocketpod_pass
STORAGE_ACCESS_KEY_ID=rocketpod
STORAGE_SECRET_ACCESS_KEY=rocketpod-secret

# AI: chat/agents need ANTHROPIC_API_KEY or AI_API_KEY (+ AI_BASE_URL/AI_MODEL for any
# OpenAI-compatible endpoint); knowledge uploads need EMBEDDINGS_* (1024-dimension vectors).
ANTHROPIC_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

# Image built by `--build`, or a published one: ghcr.io/rocketflare-dev/rocketpod:<version>
ROCKETPOD_IMAGE=rocketpod:local
WEB_PORT=3001
