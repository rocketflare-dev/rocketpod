{
  "name": "rocketpod",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rocketpod \u2014 multi-tenant SaaS for internal tools and B2B products \u2014 pnpm workspace: apps/web (Hono API + React UI on Node, in a container), apps/cli, packages/shared",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --silent --filter @rocketpod/web dev",
    "dev:stop": "pnpm --filter @rocketpod/web dev:stop",
    "dev:status": "pnpm --filter @rocketpod/web dev:status",
    "dev:db:up": "pnpm --filter @rocketpod/web dev:db:up",
    "dev:db:down": "pnpm --filter @rocketpod/web dev:db:down",
    "dev:db:status": "pnpm --filter @rocketpod/web dev:db:status",
    "bootstrap": "node scripts/bootstrap.mjs",
    "kit:upgrade": "node scripts/upgrade.mjs",
    "kit:release": "node scripts/release.mjs",
    "plugin": "node scripts/plugin.mjs",
    "preflight": "node scripts/bootstrap.mjs --check",
    "test:db:up": "pnpm --filter @rocketpod/web test:db:up",
    "test:db:down": "pnpm --filter @rocketpod/web test:db:down",
    "db:generate": "pnpm --filter @rocketpod/web db:generate",
    "db:migrate": "pnpm --filter @rocketpod/web db:migrate",
    "db:migrate:ci": "pnpm --filter @rocketpod/web db:migrate:ci",
    "db:studio": "pnpm --filter @rocketpod/web db:studio",
    "seed": "pnpm --filter @rocketpod/web seed",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "gate": "node scripts/gate.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test.mjs",
    "test:coverage": "pnpm -r test:coverage",
    "eval": "pnpm --silent --filter @rocketpod/evals eval",
    "eval:baseline": "pnpm --silent --filter @rocketpod/evals eval:baseline",
    "eval:view": "pnpm --silent --filter @rocketpod/evals eval:view",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "clean:deep": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "web": "pnpm --filter @rocketpod/web",
    "cli": "tsx apps/cli/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
